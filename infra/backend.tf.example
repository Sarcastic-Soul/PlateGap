# --------------------------------------------------------------------------
# Remote state, as an example rather than as the live configuration.
#
# The state in this repository is a local file, and for one person running
# `terraform apply` from one laptop that is not a mistake -- it is one fewer
# bucket, one fewer table, and no chicken-and-egg problem about which
# Terraform creates the backend Terraform stores its state in. The file is
# gitignored, so it is not leaking anything; it just lives in exactly one
# place.
#
# What it cannot do is survive two people. The moment a second person, or a CI
# job, runs apply, there are two states that each believe they are the truth,
# and the loser's resources become orphans that Terraform will cheerfully try
# to create again. Remote state with locking is the fix, and it is worth
# taking the moment the second person appears -- not before, and not after the
# first collision.
#
# There is also a plain durability argument: a laptop that dies takes the
# local state with it, and rebuilding it means importing every resource by
# hand. That argument is real but it is weaker than it sounds here, because
# everything in this stack is cheap to recreate from scratch and nothing holds
# data. The two-people argument is the one that should move you.
#
# To adopt it:
#
#   1. Create the bucket and the lock table once, out of band, because
#      Terraform cannot store its state in something it has not built yet:
#
#        aws s3api create-bucket --bucket plategap-tfstate-<suffix> \
#          --region us-east-1
#        aws s3api put-bucket-versioning --bucket plategap-tfstate-<suffix> \
#          --versioning-configuration Status=Enabled
#        aws s3api put-public-access-block --bucket plategap-tfstate-<suffix> \
#          --public-access-block-configuration \
#          BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
#        aws dynamodb create-table --table-name plategap-tflock \
#          --attribute-definitions AttributeName=LockID,AttributeType=S \
#          --key-schema AttributeName=LockID,KeyType=HASH \
#          --billing-mode PAY_PER_REQUEST --region us-east-1
#
#      Versioning is not optional. It is the only thing standing between a bad
#      apply and an unrecoverable state file.
#
#   2. Copy this file to `backend.tf`, fill in the bucket name, and run
#      `terraform init -migrate-state`. Terraform will offer to copy the
#      existing local state up; say yes. It reads the local file, writes it to
#      S3, and from then on the local one is only a stale copy.
#
#   3. Confirm with `terraform plan` that it reports no changes. If it wants
#      to create everything, the migration did not take and the local state is
#      still the real one -- stop and work out why before applying anything.
#
#   4. Only then delete `terraform.tfstate` locally.
#
# The order matters: migrate first and delete afterwards, so that a failed
# migration leaves the original intact rather than stranding live
# infrastructure with no state describing it.
# --------------------------------------------------------------------------

terraform {
  backend "s3" {
    bucket = "plategap-tfstate-CHANGEME"
    key    = "plategap/terraform.tfstate"
    region = "us-east-1"

    # Locking. Without it, two applies that overlap interleave their writes
    # and the state ends up describing neither run. `dynamodb_table` works on
    # every Terraform version this project supports; on 1.10 and later the
    # native S3 lock (`use_lockfile = true`) does the same job without a
    # table, and is worth switching to once everyone involved is on 1.10.
    dynamodb_table = "plategap-tflock"

    encrypt = true
  }
}
